# ============================================================
# DevWork 仓库忽略规则（根层 · 兜底层）
# 原则：宁可多挡，不可漏挡。敏感文件一旦进了 Git 历史，
#       删掉后仍可从历史中恢复，只能靠改密码 + 重写历史补救。
# ============================================================

# ---------- 环境变量文件 ----------
# 只放行 *.example / *.sample，其余 .env 变体一律不入库
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!**/.env.sample

# ---------- 密钥 / 证书 / 凭据 ----------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
secrets/
.secrets/
credentials.json
**/credentials.json
*.secret
*.secrets

# ---------- 本地数据库与运行时数据 ----------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.mdb
**/.runtime/
**/data/local/

# ---------- 依赖与构建产物 ----------
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
release/
release-test/
out/
.next/
.nuxt/
*.tsbuildinfo
vite.config.ts.timestamp-*

# ---------- 测试与覆盖率产物 ----------
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
/tmp/
dw-verify-tmp/

# ---------- Python（若后续引入脚本会用到）----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---------- 会话记忆 / 工具数据（运行时产生，不入库）----------
.workbuddy/

# ---------- 改造前快照备份 ----------
.backup-devwork/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志兜底 ----------
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 本地临时文件 ----------
*.local
.cache/
.temp/
*.bak
*.orig

# ---------- Agent 会话临时目录 / 本地 npm 缓存 / 一次性探针 ----------
.dsh-tmp/
**/.npm-cache/
**/.tmp-probe/
**/.verify-run/
