{
  "name": "devwork-app",
  "private": true,
  "version": "1.0.0",
  "description": "本地研发工作台：只读为主，写操作逐次人工批准且可回滚（受控写为实验性能力）",
  "author": "DevWork",
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "check:env": "node scripts/verify-env.mjs",
    "dev": "node scripts/dev-supervisor.mjs",
    "dev:server": "tsx watch backend/src/index.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on tcp:127.0.0.1:3001 tcp:127.0.0.1:5173 && electron .",
    "serve": "tsx backend/src/index.ts",
    "launch": "node scripts/start.mjs",
    "launch:prod": "node scripts/start.mjs --prod",
    "pack": "node scripts/package.mjs",
    "pack:dir": "node scripts/package.mjs --dir",
    "pack:zip": "node scripts/package.mjs --zip",
    "pack:installer": "node scripts/package.mjs --installer",
    "pack:portable": "node scripts/package.mjs --portable",
    "pack:all": "node scripts/package.mjs --all",
    "test:smoke": "node tests/run-smoke.mjs",
    "test:db": "node tests/db-browse.mjs",
    "test:asset": "npx tsx tests/asset-forms.spec.ts && node tests/asset-forms.mjs",
    "test:asset:visual": "node tests/run-electron.cjs asset-connect-visual.cjs",
    "test:db:visual": "node tests/run-electron.cjs db-visual.cjs",
    "test:asset-chat:visual": "node tests/run-electron.cjs asset-chat-visual.cjs",
    "test:layout:visual": "node tests/layout-visual.mjs",
    "test:refs:visual": "node tests/code-refs-visual.mjs",
    "test:todos:visual": "node tests/code-todos-visual.mjs",
    "test:rules:visual": "node tests/sensitive-rules-visual.mjs",
    "test:cred:visual": "node tests/credential-visual.mjs",
    "test:save:visual": "node tests/save-integrity-visual.mjs",
    "test:todos:copy": "npx tsx tests/todo-copy.spec.ts",
    "test:db:theme": "node tests/run-electron.cjs db-theme.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p backend/tsconfig.json",
    "build": "node scripts/build.mjs",
    "build:fast": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "smoke": "node scripts/smoke-package.mjs",
    "check:version": "node scripts/check-version.mjs",
    "dist": "node scripts/package.mjs",
    "dist:current": "node scripts/package.mjs",
    "dist:zip": "node scripts/package.mjs --zip",
    "dist:all": "node scripts/package.mjs --all",
    "dist:dir": "node scripts/package.mjs --dir",
    "dist:installer": "node scripts/package.mjs --installer",
    "dist:portable": "node scripts/package.mjs --portable",
    "test:md": "node tests/markdown.mjs",
    "test:composer": "node tests/composer.mjs",
    "test:skills": "node tests/skills.mjs",
    "test:repo": "node tests/repo-clone.mjs",
    "test": "npm run test:md && npm run test:composer && npm run test:skills && npm run test:shadow:core && npm run test:smoke && npm run test:asset",
    "test:agent-tools": "node tests/agent-tools.mjs",
    "test:attention": "node tests/attention.cjs",
    "test:browser-tool": "node tests/browser-tool.mjs",
    "test:db-integrity": "npx tsx tests/db-integrity.ts",
    "test:desktop-ipc": "node tests/desktop-ipc.mjs",
    "test:gui": "node tests/desktop-ipc.mjs",
    "test:all": "npm run test:md && npm run test:composer && npm run test:skills && npm run test:attention && npm run test:db-integrity && npm run test:browser-tool && npm run test:agent-tools && npm run test:shadow:core && npm run test:smoke && npm run test:asset",
    "preflight:release": "node scripts/preflight-release.mjs",
    "test:shadow": "node tests/run-smoke.mjs shadow",
    "test:shadow:visual": "node tests/shadow-visual.mjs",
    "test:shadow:core": "tsx tests/shadow-core.ts",
    "test:tickets": "node tests/run-smoke.mjs tickets",
    "test:search:visual": "node tests/repo-search-visual.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
