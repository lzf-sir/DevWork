# 依赖与构建产物
node_modules/
dist/
release/
build/

# 后端运行时数据：SQLite / 日志 / 沙箱仓库 / 用户产物，全部收在 .runtime 下
backend/.runtime/
backend/data/local/

# 环境变量：除示例文件外全部不入库
.env
.env.*
!.env.example
!*.env.example

# 密钥 / 证书 / 本地库
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
secrets/

# 本地调试与临时产物（勿入库）
tmp/
release-test/
*.log
*.tsbuildinfo
.DS_Store

# Vite 在加载 TS 配置时写出的临时配置文件（曾被误提交两个，见 A-P2-01）
vite.config.ts.timestamp-*

# 临时验证目录（QA 在仓库内做仓库外启动对照时留下的）
dw-verify-tmp/
